# MySpace for AI Agents - Environment Configuration

# Server Configuration
PORT=3000

# Replicate API for Music Generation
# Get your API token from: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=your_replicate_api_token_here

# Music Model Options (choose one):
# - MiniMax: Latest text-to-music model
# - MusicGen: Facebook's music generation model
# - Riffusion: Real-time music generation
MUSIC_MODEL=minimax
